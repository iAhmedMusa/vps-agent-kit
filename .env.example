# VPS Keeper agent config.
# Copy to .env and fill in real values:  cp .env.example .env && nano .env
# Never commit or upload the real .env.

# ---------- Telegram (required) ----------
# New bot per server: @BotFather -> /newbot
TELEGRAM_TOKEN=<your-telegram-bot-token>
# Leave 0 first. Start the agent, send /start to the bot, put the number here, restart.
OWNER_CHAT_ID=0

# ---------- Brain (at least one key required) ----------
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>
# First = primary, next = fallback when the first fails or is rate limited
BRAIN_ORDER=gemini,groq
# Model names change. Check AI Studio and console.groq.com/docs/models if a model errors.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Schedule ----------
TZ_NAME=Asia/Dhaka
UPGRADE_TIME=04:00
# 0=Sun 1=Mon ... 6=Sat. Weekly on Friday: UPGRADE_DAYS=5
UPGRADE_DAYS=0,1,2,3,4,5,6
# Watchdog: compare with baseline and self-heal every N minutes (0 = off)
HEALTH_INTERVAL_MIN=15

# ---------- Behaviour ----------
# Name shown in Telegram messages. Empty = hostname
SERVER_NAME=
# upgrade = safe, never removes packages. full-upgrade = also installs new deps / kernels
UPGRADE_MODE=upgrade
# true = reboot by itself after upgrade when needed (only if healthy). false = ask via Telegram
AUTO_REBOOT=false
AUTOREMOVE=false
# Max AI tool steps per heal attempt
MAX_HEAL_STEPS=15
# Skip upgrade if less free space than this on /
MIN_FREE_GB=2
DISK_ALERT_PCT=90

# ---------- Health checks ----------
# Your sites / app health endpoints, comma separated. Best signal that apps really work.
HEALTH_URLS=https://example.com,http://127.0.0.1:8000
# Ports to ignore in drift checks (random or temporary listeners), comma separated
IGNORE_PORTS=
# Regex of services to ignore in drift checks. Default covers apt timers, getty, etc.
# IGNORE_SERVICES_REGEX=^(apt-daily|unattended-upgrades|packagekit|fwupd|man-db|vps-agent)

DB_PATH=/var/lib/vps-agent/agent.db
